DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3000
NODE_ENV=development
# Must be at least 32 characters in production. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
# Optional: comma-separated list of *additional* secrets to accept on verify
# (signing always uses JWT_ACCESS_SECRET / JWT_REFRESH_SECRET). Use this when
# rotating: set the new secret as the primary, list the old secret here for a
# grace period, then drop the old secret.
# JWT_ACCESS_SECRETS_FALLBACK=old_secret_1,old_secret_2
# JWT_REFRESH_SECRETS_FALLBACK=old_refresh_secret_1
# Optional overrides — defaults are 15m / 30 days
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL_DAYS=30
# Required in production. Comma-separated list of allowed origins.
# CORS_ORIGIN=https://your-domain.com,https://staging.your-domain.com
# Optional in development. Comma-separated list of allowed origins for the
# dev server. Defaults to http://localhost:5173,http://localhost:3000.
# CORS_ORIGIN_DEV=http://localhost:5173,http://localhost:3000
# Account lockout config. After this many consecutive failed login attempts
# the account is locked for LOCKOUT_DURATION_MINUTES.
# LOGIN_MAX_FAILED_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=30
